{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$comment": "Snapshot shape only: ID ordering, next_id, rendering and unique field paths require runtime checks.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "records",
    "next_id"
  ],
  "properties": {
    "next_id": {
      "type": "integer",
      "minimum": 1
    },
    "records": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "memory_id",
          "content",
          "record"
        ],
        "properties": {
          "memory_id": {
            "type": "string",
            "pattern": "^M[0-9]{3,}$"
          },
          "content": {
            "type": "string"
          },
          "record": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "subject": {
                "type": "string",
                "minLength": 1,
                "pattern": "\\S"
              },
              "scope": {
                "type": "string",
                "minLength": 1,
                "pattern": "\\S"
              },
              "fields": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "properties": {
                    "path": {
                      "type": "string",
                      "pattern": "^[A-Za-z_][A-Za-z0-9_]*(?:\\.[A-Za-z0-9_]+)*$"
                    },
                    "value": {
                      "type": "string"
                    }
                  },
                  "required": [
                    "path",
                    "value"
                  ]
                }
              }
            },
            "required": [
              "subject",
              "scope",
              "fields"
            ]
          }
        }
      }
    }
  }
}
