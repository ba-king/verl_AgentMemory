{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "action": {
      "type": "string",
      "enum": [
        "RETRIEVE",
        "ADD",
        "UPDATE",
        "DELETE",
        "YIELD"
      ]
    },
    "arguments": {
      "type": "object"
    }
  },
  "required": [
    "action",
    "arguments"
  ],
  "additionalProperties": false,
  "oneOf": [
    {
      "type": "object",
      "properties": {
        "action": {
          "const": "RETRIEVE"
        },
        "arguments": {
          "type": "object",
          "properties": {
            "query": {
              "type": "string",
              "minLength": 1,
              "pattern": "\\S"
            }
          },
          "required": [
            "query"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "action",
        "arguments"
      ],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "action": {
          "const": "ADD"
        },
        "arguments": {
          "type": "object",
          "properties": {
            "record": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "subject": {
                  "type": "string",
                  "minLength": 1,
                  "pattern": "\\S"
                },
                "scope": {
                  "type": "string",
                  "minLength": 1,
                  "pattern": "\\S"
                },
                "fields": {
                  "type": "array",
                  "minItems": 1,
                  "items": {
                    "type": "object",
                    "additionalProperties": false,
                    "properties": {
                      "path": {
                        "type": "string",
                        "pattern": "^[A-Za-z_][A-Za-z0-9_]*(?:\\.[A-Za-z0-9_]+)*$"
                      },
                      "value": {
                        "type": "string"
                      }
                    },
                    "required": [
                      "path",
                      "value"
                    ]
                  }
                }
              },
              "required": [
                "subject",
                "scope",
                "fields"
              ]
            }
          },
          "required": [
            "record"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "action",
        "arguments"
      ],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "action": {
          "const": "UPDATE"
        },
        "arguments": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "memory_id": {
              "type": "string",
              "minLength": 1,
              "pattern": "\\S",
              "enum": [
                "M031"
              ]
            },
            "set_fields": {
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "path": {
                    "type": "string",
                    "pattern": "^[A-Za-z_][A-Za-z0-9_]*(?:\\.[A-Za-z0-9_]+)*$"
                  },
                  "value": {
                    "type": "string"
                  }
                },
                "required": [
                  "path",
                  "value"
                ]
              }
            },
            "remove_fields": {
              "type": "array",
              "uniqueItems": true,
              "items": {
                "type": "string",
                "pattern": "^[A-Za-z_][A-Za-z0-9_]*(?:\\.[A-Za-z0-9_]+)*$"
              }
            }
          },
          "required": [
            "memory_id",
            "set_fields",
            "remove_fields"
          ],
          "anyOf": [
            {
              "properties": {
                "set_fields": {
                  "minItems": 1
                }
              }
            },
            {
              "properties": {
                "remove_fields": {
                  "minItems": 1
                }
              }
            }
          ]
        }
      },
      "required": [
        "action",
        "arguments"
      ],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "action": {
          "const": "DELETE"
        },
        "arguments": {
          "type": "object",
          "properties": {
            "memory_id": {
              "type": "string",
              "enum": [
                "M031"
              ]
            }
          },
          "required": [
            "memory_id"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "action",
        "arguments"
      ],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "action": {
          "const": "YIELD"
        },
        "arguments": {
          "type": "object",
          "properties": {},
          "required": [],
          "additionalProperties": false
        }
      },
      "required": [
        "action",
        "arguments"
      ],
      "additionalProperties": false
    }
  ]
}
